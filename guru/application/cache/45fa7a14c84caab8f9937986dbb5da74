	function filterJawaraDashboard(query) {
		query = query.toLowerCase();
		$('.jawara-card, .btn-jawara-secondary-action').each(function() {
			var text = $(this).text().toLowerCase();
			if (text.indexOf(query) !== -1 || query === '') {
				$(this).show();
			} else {
				$(this).hide();
			}
		});
	}
